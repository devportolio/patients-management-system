// Prisma schema for the Patients Management System.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  user
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  role         Role     @default(user)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Patient {
  id          String   @id @default(uuid()) @db.Uuid
  firstName   String
  lastName    String
  email       String   @unique
  phoneNumber String
  dob         DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Common access patterns: search/sort by name & email, sort by dob.
  @@index([lastName, firstName])
  @@index([createdAt])
  @@map("patients")
}
