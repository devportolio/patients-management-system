# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=pms
POSTGRES_PASSWORD=pms_password
POSTGRES_DB=pms
# Used by the API (Prisma). For docker-compose the host is "db"; for local dev it's localhost.
DATABASE_URL=postgresql://pms:pms_password@localhost:5432/pms?schema=public

# ─────────────────────────────────────────────────────────────
# API (NestJS)
# ─────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=15m
# CORS origin of the web app
WEB_ORIGIN=http://localhost:3000

# Resilience / chaos simulation (random latency + occasional failures)
CHAOS_ENABLED=true
CHAOS_FAILURE_RATE=0.12
CHAOS_MIN_LATENCY_MS=100
CHAOS_MAX_LATENCY_MS=800

# ─────────────────────────────────────────────────────────────
# Web (Next.js)
# ─────────────────────────────────────────────────────────────
# Browser-facing API URL
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side (RSC/middleware/route handlers) API URL — inside docker this is http://api:4000
API_INTERNAL_URL=http://localhost:4000
